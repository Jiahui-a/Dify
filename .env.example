# 第一步：获取安灯原始数据（OData + API Key）

ANDON_ODATA_BASE_URL=https://gongsi.com:8092/andon
ANDON_ENDPOINT=o_d_andon_eventsrawdata_cur
ANDON_ENTITY_SET=o_d_andon_eventsrawdata_cur
ANDON_API_KEY=api-key3
ANDON_AUTH_HEADER=gongsi-Key
ANDON_API_KEY_HEADER=gongsi-Key
ANDON_USER_AGENT=Mozilla/5.0
ANDON_VERIFY_SSL=false
ANDON_TIMEOUT_SECONDS=120
ANDON_TOP_N=2000
ANDON_USE_SELECT=true
ANDON_OUTPUT_DIR=./data/raw

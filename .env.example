# 安灯 OData API 连接配置（对齐公司 ApiConfig）
# 复制本文件为 .env，把 API_KEY 换成真实密钥

# 对应 ApiConfig.base_url
ANDON_ODATA_BASE_URL=https://gongsi.com:8092/andon

# 对应 ApiConfig.endpoint（原始事件表）
ANDON_ENDPOINT=o_d_andon_eventsrawdata_cur
ANDON_ENTITY_SET=o_d_andon_eventsrawdata_cur

# 对应 ApiConfig.api_key
ANDON_API_KEY=API_KEY

# 对应 ApiConfig.auth_header：请求头名为 ABC，值为 API Key
# 实际发送: ABC: <ANDON_API_KEY>
ANDON_API_KEY_MODE=header_custom
ANDON_AUTH_HEADER=ABC
ANDON_API_KEY_HEADER=ABC

# 对应 ApiConfig.user_agent
ANDON_USER_AGENT=Mozilla/5.0

# 对应 ApiConfig.verify_ssl / timeout_seconds / top_n
ANDON_VERIFY_SSL=false
ANDON_TIMEOUT_SECONDS=120
ANDON_TOP_N=500
ANDON_PAGE_SIZE=500

# 输出目录
ANDON_OUTPUT_DIR=./data/raw

# 可选：$filter，例如按时间拉取
# ANDON_FILTER=begintime ge 2026-01-01T00:00:00Z
ANDON_FILTER=

# 可选：额外查询参数（JSON）
# ANDON_EXTRA_PARAMS={"$orderby":"begintime desc"}
ANDON_EXTRA_PARAMS=

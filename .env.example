# 安灯 OData API 连接配置
# 复制本文件为 .env 并填入真实值

# OData 服务根地址（不要带末尾斜杠）
# 示例: https://mes.company.com/odata
ANDON_ODATA_BASE_URL=https://your-company-server/odata

# 实体集名称（报警/维修记录表在 OData 中的名字）
# 常见示例: AndonEvents, AndonAlarms, RepairRecords, AndonRecords
ANDON_ENTITY_SET=AndonEvents

# API Key（公司服务器鉴权）
ANDON_API_KEY=your-api-key-here

# API Key 传递方式:
#   header_api_key      -> Header: api-key: <key>
#   header_x_api_key    -> Header: X-API-Key: <key>
#   header_authorization_apikey -> Header: Authorization: ApiKey <key>
#   header_authorization_bearer -> Header: Authorization: Bearer <key>
#   query_api_key       -> Query: ?api-key=<key>
#   query_apikey        -> Query: ?apiKey=<key>
ANDON_API_KEY_MODE=header_api_key

# 可选：自定义 Header 名（当 MODE=header_custom 时使用）
# ANDON_API_KEY_HEADER=X-Custom-Api-Key

# 分页大小（OData $top）
ANDON_PAGE_SIZE=500

# 请求超时（秒）
ANDON_TIMEOUT_SECONDS=60

# 是否校验证书（内网自签证书可设为 false）
ANDON_VERIFY_SSL=true

# 输出目录
ANDON_OUTPUT_DIR=./data/raw

# 可选：$filter 条件，例如按时间拉取
# ANDON_FILTER=begintime ge 2026-01-01T00:00:00Z
ANDON_FILTER=

# 可选：额外查询参数（JSON 对象字符串）
# ANDON_EXTRA_PARAMS={"$orderby":"begintime desc"}
ANDON_EXTRA_PARAMS=
